# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@www.youlai.tech:15432/youlai_admin

# Redis
REDIS_URL=redis://:123456@www.youlai.tech:6379/0

# 认证（令牌存储：jwt / redis）
SESSION_TYPE=jwt
JWT_SECRET_KEY=SecretKey012345678901234567890123456789012345678901234567890123456789
# 有效期（秒）
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800
ALLOW_MULTI_LOGIN=true

# 对象存储
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rustfs-admin
S3_SECRET_KEY=rustfs-admin
S3_BUCKET=public
S3_SECURE=false

# 邮件（587 配 STARTTLS，465 配 SSL）
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=123456
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# 限流（单 IP 窗口内请求数 / 窗口秒数）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_LIMIT=1000
RATE_LIMIT_IP_WINDOW=60

# 跨域（* 表示全部放行，不支持 Cookie）
ALLOWED_ORIGINS=*

# 上传（单文件上限 MB，扩展名逗号分隔）
FILE_MAX_SIZE_MB=50
FILE_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,xlsx,xls,docx,doc,zip

# 调试（true 时打印 SQL）
DEBUG=false
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
