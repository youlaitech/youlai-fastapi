# ==================== 数据库 ====================
DATABASE_URL=postgresql+asyncpg://youlai:Youlai%402026@www.youlai.tech:15432/youlai_admin

# ==================== Redis ====================
REDIS_URL=redis://:123456@www.youlai.tech:6379/0

# ==================== 认证 ====================
SESSION_TYPE=jwt
JWT_SECRET_KEY=SecretKey012345678901234567890123456789012345678901234567890123456789
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800
ALLOW_MULTI_LOGIN=true

# ==================== MinIO 文件存储 ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=public
MINIO_SECURE=false

# ==================== 邮件 ====================
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=123456
MAIL_FROM=youlaitech@163.com
MAIL_PORT=587
MAIL_SERVER=smtp.youlai.tech
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ==================== 限流 ====================
RATE_LIMIT_QPS=5

# ==================== CORS ====================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== 文件上传 ====================
FILE_MAX_SIZE_MB=50
FILE_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,xlsx,xls,docx,doc,zip

# ==================== 多租户 ====================
TENANT_ENABLE=false

# ==================== 调试 ====================
DEBUG=false
LOG_LEVEL=INFO
